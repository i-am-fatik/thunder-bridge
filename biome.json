{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"formatter": { "enabled": true, "indentStyle": "tab", "lineWidth": 100 },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"style": { "useBlockStatements": "error" }
		}
	},
	"files": {
		"includes": [
			"core/**/*.ts",
			"src/**/*.ts",
			"tools/**/*.ts",
			"sdk/src/**/*.ts",
			"sdk/test/**/*.ts"
		]
	}
}
