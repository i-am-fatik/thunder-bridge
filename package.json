{
	"name": "thunder-bridge",
	"version": "0.1.0",
	"description": "Lightning payments with no node: the payer pays the recipient's own invoice and LUD-21 proves delivery",
	"license": "MIT",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"engines": {
		"node": ">=24.2"
	},
	"scripts": {
		"start": "node src/index.ts",
