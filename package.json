{
  "name": "thunder-bridge",
  "version": "1.5.0",
  "description": "Lightning payments with no node: the payer pays the recipient's own invoice and LUD-21 proves delivery",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=26.8.1"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "docs": "npm --prefix sdk run build && node tools/api-reference.ts . && node tools/recipes.ts . && node tools/demo.ts .",
    "docs:serve": "npm run docs && node docs/demo/serve.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "^6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@hyperswarm/secret-stream": "6.9.1",
    "compact-encoding": "3.3.2",
    "hyperswarm": "4.17.0",
    "protomux": "3.11.0",
    "thunder-bridge": "file:./sdk",
    "ws": "^8.21.3"
  }
}
