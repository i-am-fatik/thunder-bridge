		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@types/ws": "^8.18.1",
		"typescript": "^5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@hyperswarm/secret-stream": "6.9.1",
		"compact-encoding": "3.3.0",
		"hyperswarm": "4.17.0",
		"protomux": "3.11.0",
		"ws": "^8.21.1"
	}
