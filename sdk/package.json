{
  "name": "thunder-bridge",
  "version": "1.2.0",
  "description": "Trustless JavaScript client for the Thunder Bridge Lightning payment gateway. Proves the invoice came from your own wallet before the payer sees it.",
  "author": "i-am-fatik",
  "homepage": "https://agora.gripe/en/tools/thunder-bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-am-fatik/thunder-bridge.git",
    "directory": "sdk"
  },
  "bugs": "https://github.com/i-am-fatik/thunder-bridge/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    }
  },
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm,cjs --dts --clean --splitting=false",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "format": "biome check --write src test",
    "check:pkg": "npx --yes publint && npx --yes @arethetypeswrong/cli --pack .",
    "prepublishOnly": "npm run build && npx --yes publint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^24.13.3",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "lightning",
    "bitcoin",
    "lnurl",
    "lud-21",
    "trustless",
    "payments",
    "websocket"
  ],
  "license": "MIT",
  "dependencies": {
    "@noble/ciphers": "2.3.0",
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0",
    "uqr": "^0.1.2"
  }
}
