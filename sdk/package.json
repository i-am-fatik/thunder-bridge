{
  "name": "thunder-bridge",
  "version": "0.8.1",
  "description": "Trustless JavaScript client for the Thunder Bridge Lightning payment gateway. Proves the invoice came from your own wallet before the payer sees it.",
  "author": "i-am-fatik",
  "homepage": "https://agora.gripe/en/tools/thunder-bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-am-fatik/thunder-bridge.git",
    "directory": "sdk"
  },
  "bugs": "https://github.com/i-am-fatik/thunder-bridge/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "format": "biome format --write src test",
    "check:pkg": "npx --yes publint && npx --yes @arethetypeswrong/cli --pack .",
    "prepublishOnly": "npm run build && npx --yes publint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "lightning",
    "bitcoin",
    "lnurl",
    "lud-21",
    "trustless",
    "payments",
    "websocket"
  ],
  "license": "MIT",
  "dependencies": {
    "uqr": "^0.1.2"
  }
}
