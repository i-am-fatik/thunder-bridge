{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "declaration": true,
    "rootDir": "..",
    "outDir": "dist",
    "skipLibCheck": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "structured-headers": ["./node_modules/structured-headers/dist/index.d.ts"]
    }
  },
  "include": ["src"]
}
